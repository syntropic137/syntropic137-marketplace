{
  "triggers": [
    {
      "name": "on-ci-failure",
      "description": "Auto-fix CI failures on pull requests (webhook-only — requires webhook URL)",
      "event": "check_run",
      "conditions": [
        {
          "field": "action",
          "operator": "eq",
          "value": "completed"
        },
        {
          "field": "check_run.conclusion",
          "operator": "eq",
          "value": "failure"
        },
        {
          "field": "check_run.pull_requests",
          "operator": "not_empty"
        }
      ],
      "input_mapping": {
        "pr_number": "check_run.pull_requests[0].number",
        "repository": "repository.full_name",
        "branch": "check_run.head_branch",
        "check_run_name": "check_run.name",
        "check_run_id": "check_run.id"
      },
      "config": {
        "max_attempts": 2,
        "cooldown_seconds": 600,
        "daily_limit": 10,
        "budget_per_trigger_usd": 5.00,
        "debounce_seconds": 30
      }
    }
  ]
}
