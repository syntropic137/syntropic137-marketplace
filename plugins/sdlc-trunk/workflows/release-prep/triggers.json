{
  "triggers": [
    {
      "name": "on-release-created",
      "description": "Prepare release notes when a new release is created",
      "event": "release",
      "conditions": [
        {
          "field": "action",
          "operator": "in",
          "value": ["created", "published"]
        }
      ],
      "input_mapping": {
        "repository": "repository.full_name",
        "tag": "release.tag_name",
        "release_name": "release.name",
        "draft": "release.draft"
      },
      "config": {
        "max_attempts": 1,
        "cooldown_seconds": 600,
        "daily_limit": 5,
        "budget_per_trigger_usd": 2.00
      }
    }
  ]
}
